{
  "enabled": true,
  "name": "Sync Documentation",
  "description": "When Python source files or configuration files are edited, prompts the agent to review changes and update relevant documentation in README.md or docs folder.",
  "version": "1",
  "when": {
    "type": "fileEdited",
    "patterns": [
      "*.py",
      "pyproject.toml"
    ]
  },
  "then": {
    "type": "askAgent",
    "prompt": "A source file was just edited. Review the changes made and determine if the README.md or any documentation in a /docs folder needs to be updated to reflect these changes. If documentation updates are needed, make the appropriate changes to keep docs in sync with the code. Focus on: function/class documentation, usage examples, configuration changes, and API updates."
  }
}